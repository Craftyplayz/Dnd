# Copy to .env and fill in. Never commit .env.

# Required. Login password, at least 12 characters (the server refuses to start otherwise).
APP_PASSWORD=

# Anthropic API key. Without it the app runs but Generate / AI edit return 503.
ANTHROPIC_API_KEY=

# Model override (default: config.json "model", then claude-sonnet-5-5).
# CLAUDE_MODEL=claude-sonnet-5-5

# Port the server listens on. In Docker it is fixed to 8080; change HOST_PORT instead.
PORT=8080
# Host port published by docker-compose.yml.
HOST_PORT=8080

# Where scenes, usage counters and the session secret live. Docker always uses /data (named volume).
DATA_DIR=./data

# Cookie signing secret (64 hex chars). Unset = generated once into DATA_DIR/session_secret.
# Changing it logs everyone out.
# SESSION_SECRET=

# 1 = mark the session cookie Secure. Set when served over HTTPS.
COOKIE_SECURE=0

# 1 = trust the right-most X-Forwarded-For entry as the client IP (only behind your own reverse proxy).
TRUSTED_PROXY=0

# AI requests per minute per session.
RATE_LIMIT_PER_MIN=20

# AI requests per UTC day, all users together.
DAILY_REQUEST_CAP=300

# Largest accepted request body in bytes (2 MiB).
MAX_BODY_BYTES=2097152

# Failed logins from one IP before it is locked out, and the lockout length in minutes.
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_MIN=15

# Tests only: point the server at a fake Anthropic endpoint.
# ANTHROPIC_API_URL=http://127.0.0.1:9999/v1/messages
